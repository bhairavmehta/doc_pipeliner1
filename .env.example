# Copy to .env (never commit .env). All settings are optional: without them every critic runs in rule mode.

# Small language models for the critic panel (any OpenAI-compatible server inside the approved environment:
# vLLM, Ollama, TGI, LM Studio). Used when --critic-mode hybrid.
SLM_BASE_URL=http://localhost:8000/v1
SLM_MODEL=qwen3-8b-req-critic
# SLM_API_KEY=
# Hybrid evidence retrieval (K3)
# SLM_EMBED_MODEL=bge-m3
# SLM_RERANK_MODEL=bge-reranker-v2-m3
# Vision model for figure review (C5)
# SLM_VLM_MODEL=qwen2.5-vl-7b

# J1 judge (frontier model; falls back to the LLM_* settings below). Used with --judge.
# JUDGE_PROVIDER=openai
# JUDGE_BASE_URL=https://<company-gateway>/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=

# Existing setting for research_findings.py --mode llm
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Pipeline defaults (command-line flags override)
# CRITIC_MODE=rules
# DRAFT_MODE=whole
# REVISE_ROUNDS=2
